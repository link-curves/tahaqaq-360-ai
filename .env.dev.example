# ==================================
# Environment Variables - Development
# ==================================
# Copy to .env.dev and fill in. .env.dev is git-ignored — never commit it.
#
#   cp .env.dev.example .env.dev
#
# Used by: docker-compose.dev.yml (via env_file)

# ---------------------------------
# Database
# ---------------------------------
# Pooled connection (pgbouncer) — used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Direct connection — required by Prisma Migrate (migrations cannot run
# through a transaction pooler).
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Read-only role used by the Postgres MCP server. See docs/SECURITY-REMEDIATION.md
# for the SQL that creates this role. Must NOT be the owner/superuser account.
DATABASE_READONLY_URL=postgresql://mcp_readonly:PASSWORD@HOST:5432/postgres?sslmode=require

# ---------------------------------
# JWT Authentication
# ---------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---------------------------------
# Google OAuth
# ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ---------------------------------
# Supabase Storage
# ---------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=tahaqaq-uploads
