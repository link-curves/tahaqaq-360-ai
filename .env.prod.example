# ==================================
# Environment Variables - Production
# ==================================
# Copy this file to .env.prod and fill in your values

# ---------------------------------
# Database
# ---------------------------------
POSTGRES_USER=tahaqaq
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=tahaqaq_db
POSTGRES_PORT=5432

# Database URLs (will be constructed automatically)
DATABASE_URL=postgresql://tahaqaq:change_this_strong_password@postgres:5432/tahaqaq_db?schema=public
DATABASE_DIRECT_URL=postgresql://tahaqaq:change_this_strong_password@postgres:5432/tahaqaq_db?schema=public

# ---------------------------------
# Application
# ---------------------------------
NODE_ENV=production
API_PORT=5000
WEB_PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# API URL for frontend
VITE_API_URL=https://api.yourdomain.com/api/v1

# ---------------------------------
# JWT Authentication
# ---------------------------------
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=generate_a_strong_random_secret_here
JWT_REFRESH_SECRET=generate_another_strong_random_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---------------------------------
# Google OAuth
# ---------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback

# ---------------------------------
# Supabase Storage
# ---------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_BUCKET=tahaqaq-uploads

# ---------------------------------
# Rate Limiting
# ---------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---------------------------------
# Email Configuration (Optional)
# ---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com
