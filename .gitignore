# ---------------------------------------------------------------
# Secrets — ignore every env file, allow only *.example templates.
# Order matters: the negation must come after the broad ignores.
# ---------------------------------------------------------------
.env*
!.env*.example


apps/**/node_modules
apps/**/dist
apps/**/dist-ssr
apps/**/.turbo
apps/**/.cache
apps/**/server/dist

packages/**/node_modules
packages/**/dist
packages/**/.turbo
packages/**/.cache
