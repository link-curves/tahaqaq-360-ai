generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

// ============================================
// ENUMS
// ============================================

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  password        String? // Null for OAuth users
  firstName       String?
  lastName        String?
  username        String? @unique
  avatar          String?
  bio             String?
  roleCode        String  @default("USER")
  role            Role    @relation(fields: [roleCode], references: [code])
  isEmailVerified Boolean @default(false)
  googleId        String? @unique
  reputation      Int     @default(0)
  totalPoints     Int     @default(0)
  level           Int     @default(1)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  submissions        Submission[]
  authoredArticles   FactCheckArticle[]  @relation("ArticleAuthor")
  editedArticles     FactCheckArticle[]  @relation("ArticleEditor")
  articleRevisions   ArticleRevision[]   @relation("RevisionEditor")
  verdictChangesMade VerdictChange[]     @relation("VerdictChangedBy")
  verdictApprovals   VerdictChange[]     @relation("VerdictApprovedBy")
  certificates       Certificate[]
  eventRegistrations EventRegistration[]
  achievements       UserAchievement[]
  notifications      Notification[]
  comments           Comment[]
  courseProgress     CourseProgress[]
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  moderationActions  ModerationLog[]
  contactMessages    ContactMessage[]
  savedContent       SavedContent[]
  activityLogs       ActivityLog[]

  @@index([email])
  @@index([roleCode])
  @@index([reputation])
  @@map("users")
}

// ============================================
// FACT CHECKING CORE
// ============================================

// ============================================
// EDITORIAL RECORD
// Claim -> FactCheck (the review) -> FactCheckArticle (one per locale)
// See ADR-0002, ADR-0005, ADR-0006, ADR-0007.
// ============================================

/// What was asserted, independent of who checked it.
///
/// Separated from the review so the same claim can be re-reviewed later and
/// recognised across submissions — which is also the hook the AI deduplication
/// stage needs.
model Claim {
  id           String    @id @default(cuid())
  text         String    @db.Text // as circulated, in its original language
  languageCode String?
  language     Locale?   @relation(fields: [languageCode], references: [code])
  claimantName String? // who spread it
  claimedAt    DateTime? // when the claim was made
  firstSeenAt  DateTime? // when the desk first saw it circulating

  appearances ClaimAppearance[]
  reviews     FactCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimedAt])
  @@map("claims")
}

/// Where a claim showed up. A claim appears in many places (a tweet, a WhatsApp
/// forward, a TV segment), so this is a collection, not a column.
///
/// `archiveUrl` is the load-bearing field: claims get deleted, and the snapshot
/// is the difference between a defensible fact-check and an unfalsifiable one.
model ClaimAppearance {
  id         String    @id @default(cuid())
  claimId    String
  claim      Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  url        String
  platform   String? // twitter | facebook | whatsapp | tv | news | other
  publisher  String?
  appearedAt DateTime?
  archiveUrl String?
  archivedAt DateTime?
  mediaUrls  String[]

  createdAt DateTime @default(now())

  @@index([claimId])
  @@map("claim_appearances")
}

/// The editorial review of a claim. Language-neutral.
///
/// The verdict lives HERE, not on the article, and that is deliberate: if each
/// locale carried its own rating, nothing would stop the Arabic reading
/// MOSTLY_TRUE while the English reads HALF_TRUE. Publishing two ratings for one
/// claim under one masthead is not a defect you can ship.
model FactCheck {
  id      String         @id @default(cuid())
  claimId String
  claim   Claim          @relation(fields: [claimId], references: [id])
  verdictCode String
  verdict     VeracityRating @relation(fields: [verdictCode], references: [code])

  /// ISO 3166-1 alpha-2. Validated against `Country` in the service layer.
  countryCodes String[]

  /// Free-text, SEO/discovery only. NEVER the basis for filtering, navigation,
  /// or reporting — those read `topics` and `countryCodes`. See ADR-0007.
  tags String[]

  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])

  articles       FactCheckArticle[]
  evidence       Evidence[]
  topics         FactCheckTopic[]
  verdictChanges VerdictChange[]

  // Engagement and discussion are language-independent, so they stay on the
  // review rather than the article.
  comments Comment[]
  savedBy  SavedContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verdictCode])
  @@index([claimId])
  @@map("fact_checks")
}

/// One per locale. A full editorial artifact: its own byline, editor, publish
/// state and revision history. The English version is not a translation row —
/// it can be corrected while the Arabic is not.
model FactCheckArticle {
  id          String    @id @default(cuid())
  factCheckId String
  factCheck   FactCheck @relation(fields: [factCheckId], references: [id], onDelete: Cascade)
  localeCode  String
  locale      Locale @relation(fields: [localeCode], references: [code])

  slug        String
  title       String
  summary     String  @db.Text
  body        String  @db.Text
  methodology String? @db.Text

  statusCode  String        @default("DRAFT")
  status      ContentStatus @relation(fields: [statusCode], references: [code])
  publishedAt DateTime?

  /// Byline — who wrote it.
  authorId String
  author   User    @relation("ArticleAuthor", fields: [authorId], references: [id])
  /// Editor — who reviewed it. A distinct step from submission moderation.
  /// Service layer requires this to be set (and to differ from authorId)
  /// before an article may reach PUBLISHED.
  editorId String?
  editor   User?   @relation("ArticleEditor", fields: [editorId], references: [id])

  reviewedAt DateTime?

  metaTitle       String?
  metaDescription String?
  featuredImage   String?
  isFeatured      Boolean @default(false)

  views  Int @default(0)
  shares Int @default(0)

  revisions ArticleRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factCheckId, localeCode]) // one article per locale per review
  @@unique([localeCode, slug]) // slugs are unique WITHIN a locale, not globally
  @@index([statusCode])
  @@index([publishedAt])
  @@index([authorId])
  @@map("fact_check_articles")
}

/// An ordered citation. Replaces the old `sources Json[]`, which was typed
/// `any[]` end to end and could not be ordered, queried, or archived.
///
/// Hangs off the review, not the article: a URL is language-neutral and both
/// locales cite the same sources. See ADR-0005.
model Evidence {
  id          String    @id @default(cuid())
  factCheckId String
  factCheck   FactCheck @relation(fields: [factCheckId], references: [id], onDelete: Cascade)

  /// Presentation order. Normalised to a contiguous 0..n-1 range on write.
  /// Indexed rather than @@unique — a unique constraint would make reordering
  /// require temporary values.
  position Int
  typeCode String       @default("OTHER")
  type     EvidenceType @relation(fields: [typeCode], references: [code])

  url         String
  title       String?
  publisher   String?
  publishedAt DateTime? // the source's own publication date
  /// When the analyst actually consulted it. Required: a source that said X in
  /// January and Y in March makes the fact-check unfalsifiable without this.
  accessedAt  DateTime
  archiveUrl  String?
  archivedAt  DateTime?

  excerpt String? @db.Text // the passage relied on
  note    String? @db.Text // INTERNAL — must never be serialized publicly

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factCheckId, position])
  @@index([publisher])
  @@map("evidence")
}

/// Append-only snapshot of an article. There is no update or delete path for
/// this table, including for admins. See ADR-0006.
model ArticleRevision {
  id             String           @id @default(cuid())
  articleId      String
  article        FactCheckArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionNumber Int // 1-based, per article
  tierCode       String
  tier           RevisionTier @relation(fields: [tierCode], references: [code])

  // Full snapshot as the article stood at this revision. Snapshots rather than
  // diffs: the requirement is "serve the version as it was on date X", which a
  // snapshot answers directly.
  title         String
  summary       String         @db.Text
  body          String         @db.Text
  methodology   String?        @db.Text
  /// Denormalised deliberately. Replaying VerdictChange against timestamps to
  /// work out the rating at a point in time is right in principle and wrong at 2am.
  verdictAtTimeCode String
  verdictAtTime     VeracityRating @relation(fields: [verdictAtTimeCode], references: [code])

  noticeText String? @db.Text // PUBLIC. Required unless tier is SILENT.
  reason     String? @db.Text // INTERNAL — never serialized publicly

  editedById String
  editedBy   User   @relation("RevisionEditor", fields: [editedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([articleId, revisionNumber])
  @@index([articleId, createdAt])
  @@map("article_revisions")
}

/// A change to a published rating — the highest-consequence edit in the system.
/// Requires a second person: `approvedById` must be set and must differ from
/// `changedById`. Propagates a CORRECTION-or-higher revision to every published
/// article of the fact-check, in both locales.
model VerdictChange {
  id          String    @id @default(cuid())
  factCheckId String
  factCheck   FactCheck @relation(fields: [factCheckId], references: [id], onDelete: Cascade)

  fromVerdictCode String
  fromVerdict     VeracityRating @relation("VerdictChangeFrom", fields: [fromVerdictCode], references: [code])
  toVerdictCode   String
  toVerdict       VeracityRating @relation("VerdictChangeTo", fields: [toVerdictCode], references: [code])
  reason      String         @db.Text // public

  changedById  String
  changedBy    User   @relation("VerdictChangedBy", fields: [changedById], references: [id])
  approvedById String
  approvedBy   User   @relation("VerdictApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([factCheckId])
  @@map("verdict_changes")
}

// ============================================
// TAXONOMY (ADR-0007)
// ============================================

/// Curated, editor-owned. Keep it small — 10-25 flat topics. A taxonomy that
/// outgrows one screen stops being applied consistently.
model Topic {
  id            String  @id @default(cuid())
  slug          String  @unique // stable machine key
  labelAr       String
  labelEn       String
  descriptionAr String?
  descriptionEn String?
  position      Int     @default(0)
  /// Retire a topic without orphaning the fact-checks already classified under it.
  isActive      Boolean @default(true)

  factChecks FactCheckTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topics")
}

model FactCheckTopic {
  factCheckId String
  topicId     String
  factCheck   FactCheck @relation(fields: [factCheckId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id])

  @@id([factCheckId, topicId])
  @@index([topicId])
  @@map("fact_check_topics")
}

/// ISO 3166-1 reference data, seeded. Exists so filter UIs and reports can join
/// for bilingual names instead of hardcoding a name map in two frontends.
model Country {
  code   String @id // ISO 3166-1 alpha-2
  nameAr String
  nameEn String

  @@map("countries")
}

model Submission {
  id            String           @id @default(cuid())
  typeCode      String
  type          SubmissionType   @relation(fields: [typeCode], references: [code])
  content       String           @db.Text
  sourceUrl     String?
  mediaUrls     String[]
  context       String?          @db.Text
  statusCode    String           @default("PENDING")
  status        SubmissionStatus @relation(fields: [statusCode], references: [code])
  priority      Int              @default(0)
  internalNotes String?          @db.Text

  // Submitter info
  submitterId    String
  submitter      User    @relation(fields: [submitterId], references: [id])
  submitterEmail String?
  isAnonymous    Boolean @default(false)

  // Review process
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  factCheck      FactCheck?
  moderationLogs ModerationLog[]

  @@index([statusCode])
  @@index([submitterId])
  @@index([createdAt])
  @@map("submissions")
}

// ============================================
// MEDIA LITERACY EDUCATION
// ============================================

model Course {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String   @db.Text
  coverImage         String?
  difficulty         String // Beginner, Intermediate, Advanced
  duration           Int // in minutes
  order              Int      @default(0)
  isPublished        Boolean  @default(false)
  prerequisites      String[]
  learningObjectives String[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lessons      Lesson[]
  enrollments  CourseProgress[]
  certificates Certificate[]

  @@index([slug])
  @@index([isPublished])
  @@map("courses")
}

model Lesson {
  id        String  @id @default(cuid())
  title     String
  slug      String
  content   String  @db.Text
  videoUrl  String?
  duration  Int? // in minutes
  order     Int
  resources Json[] // Downloadable resources

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  quiz           Quiz?
  lessonProgress LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@map("lessons")
}

model Quiz {
  id           String @id @default(cuid())
  title        String
  passingScore Int    @default(70)
  timeLimit    Int? // in minutes
  questions    Json[] // Array of question objects

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attempts QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id        String  @id @default(cuid())
  score     Int
  answers   Json // User's answers
  isPassed  Boolean
  timeSpent Int? // in seconds

  userId String
  user   User   @relation(fields: [userId], references: [id])
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model CourseProgress {
  id             String    @id @default(cuid())
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  progress       Int       @default(0) // Percentage
  lastAccessedAt DateTime  @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Timestamps
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_progress")
}

model LessonProgress {
  id          String    @id @default(cuid())
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ============================================
// CERTIFICATES
// ============================================

model Certificate {
  id                String @id @default(cuid())
  certificateNumber String @unique
  verificationCode  String @unique

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Certificate data
  recipientName String
  issuedDate    DateTime  @default(now())
  expiryDate    DateTime?
  pdfUrl        String?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([certificateNumber])
  @@index([userId])
  @@map("certificates")
}

// ============================================
// EVENTS & WORKSHOPS
// ============================================

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String      @db.Text
  typeCode    String
  type        EventType   @relation(fields: [typeCode], references: [code])
  statusCode  String      @default("UPCOMING")
  status      EventStatus @relation(fields: [statusCode], references: [code])
  coverImage  String?

  // Event details
  startDate    DateTime
  endDate      DateTime
  location     String?
  virtualLink  String?
  isVirtual    Boolean  @default(false)
  maxAttendees Int?

  // Additional info
  speakers     Json[] // Array of speaker objects
  agenda       Json[]
  requirements String[]
  tags         String[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  registrations EventRegistration[]

  @@index([slug])
  @@index([statusCode])
  @@index([startDate])
  @@map("events")
}

model EventRegistration {
  id String @id @default(cuid())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Registration details
  status     String    @default("CONFIRMED") // CONFIRMED, CANCELLED, ATTENDED
  attendedAt DateTime?
  feedback   String?
  rating     Int?

  // Timestamps
  registeredAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_registrations")
}

model HostRequest {
  id String @id @default(cuid())

  // Requester info
  name         String
  email        String
  phone        String?
  organization String?

  // Event details
  proposedTitle     String
  description       String    @db.Text
  eventTypeCode     String
  eventType         EventType @relation(fields: [eventTypeCode], references: [code])
  preferredDate     DateTime
  expectedAttendees Int?
  location          String?

  // Status
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNotes String?
  reviewedAt  DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("host_requests")
}

model TrainingRequest {
  id String @id @default(cuid())

  // Requester info
  name         String
  email        String
  phone        String?
  organization String
  position     String?

  // Training details
  trainingTopic     String
  description       String    @db.Text
  preferredDate     DateTime?
  alternativeDate   DateTime?
  expectedAttendees Int
  location          String
  targetAudience    String? // e.g., "Students", "Teachers", "Journalists"
  specificNeeds     String?   @db.Text

  // Status
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, CONTACTED
  reviewNotes String?   @db.Text
  reviewedBy  String?
  reviewedAt  DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("training_requests")
}

// ============================================
// RECORDED SESSIONS
// ============================================

model Session {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  description  String  @db.Text
  videoUrl     String
  thumbnailUrl String?
  duration     Int // in minutes
  views        Int     @default(0)

  // Content details
  speakers  Json[]
  topics    String[]
  resources Json[]

  // Publishing
  statusCode  String        @default("DRAFT")
  status      ContentStatus @relation(fields: [statusCode], references: [code])
  publishedAt DateTime?

  // Timestamps
  recordedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([slug])
  @@index([statusCode])
  @@map("sessions")
}

// ============================================
// BLOG POSTS
// ============================================

model Blog {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String   @db.Text
  content    String   @db.Text
  coverImage String?
  author     String
  category   String
  tags       String[]
  isFeatured Boolean  @default(false)

  // Publishing
  statusCode  String        @default("DRAFT")
  status      ContentStatus @relation(fields: [statusCode], references: [code])
  publishedAt DateTime?

  // Metrics
  views    Int  @default(0)
  readTime Int? // in minutes

  // SEO
  metaTitle       String?
  metaDescription String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([statusCode])
  @@index([category])
  @@index([publishedAt])
  @@map("blog_posts")
}

// ============================================
// RESEARCH & INSIGHTS
// ============================================

model Research {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String   @db.Text
  fullContent String   @db.Text
  authors     String[]
  category    String
  tags        String[]
  isFeatured  Boolean  @default(false)

  // Media
  coverImage  String?
  attachments Json[]

  // Publishing
  statusCode  String        @default("DRAFT")
  status      ContentStatus @relation(fields: [statusCode], references: [code])
  publishedAt DateTime?

  // Metrics
  views     Int @default(0)
  downloads Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([statusCode])
  @@map("research")
}

// ============================================
// FAQ
// ============================================

model FAQ {
  id          String  @id @default(cuid())
  question    String
  answer      String  @db.Text
  category    String
  order       Int     @default(0)
  isPublished Boolean @default(true)
  views       Int     @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("faqs")
}

// ============================================
// CONTACT
// ============================================

model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String  @db.Text

  // Status
  status      String    @default("NEW") // NEW, IN_PROGRESS, RESOLVED
  response    String?   @db.Text
  respondedAt DateTime?
  respondedBy String?

  // User relation (if logged in)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ============================================
// GAMIFICATION
// ============================================

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  points      Int
  category    String // Learning, Contribution, Social, etc.
  criteria    Json // Conditions to unlock

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id String @id @default(cuid())

  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  // Timestamps
  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  typeCode  String
  type      NotificationType @relation(fields: [typeCode], references: [code])
  title     String
  message   String
  actionUrl String?
  isRead    Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Timestamps
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================
// MODERATION
// ============================================

model ModerationLog {
  id     String           @id @default(cuid())
  actionCode String
  action     ModerationAction @relation(fields: [actionCode], references: [code])
  reason String?
  notes  String?          @db.Text

  moderatorId String
  moderator   User   @relation(fields: [moderatorId], references: [id])

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())

  @@index([moderatorId])
  @@index([submissionId])
  @@map("moderation_logs")
}

// ============================================
// COMMENTS & ENGAGEMENT
// ============================================

model Comment {
  id       String  @id @default(cuid())
  content  String  @db.Text
  isEdited Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  factCheckId String?
  factCheck   FactCheck? @relation(fields: [factCheckId], references: [id], onDelete: Cascade)

  // Nesting
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([factCheckId])
  @@map("comments")
}

model SavedContent {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  factCheckId String?
  factCheck   FactCheck? @relation(fields: [factCheckId], references: [id])

  // Timestamps
  savedAt DateTime @default(now())

  @@unique([userId, factCheckId])
  @@index([userId])
  @@map("saved_content")
}

// ============================================
// ANALYTICS & LOGGING
// ============================================

model ActivityLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model SystemMetric {
  id       String @id @default(cuid())
  metric   String
  value    Float
  metadata Json?

  // Timestamps
  recordedAt DateTime @default(now())

  @@index([metric])
  @@index([recordedAt])
  @@map("system_metrics")
}

model PrivacyPolicy {
  id        String  @id @default(cuid())
  version   String  @unique
  content   String  @db.Text
  isCurrent Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())

  @@map("privacy_policies")
}

model TermsOfService {
  id        String  @id @default(cuid())
  version   String  @unique
  content   String  @db.Text
  isCurrent Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())

  @@map("terms_of_service")
}

model AccessibilityStatement {
  id        String  @id @default(cuid())
  version   String  @unique
  content   String  @db.Text
  isCurrent Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())

  @@map("accessibility_statements")
}

// ============================================
// LOOKUP / REFERENCE TABLES
//
// Formerly Prisma enums, now rows, so values can be added without a schema
// change. Keyed by a semantic `code` rather than a cuid: a random primary key
// makes `@default("DRAFT")` impossible on the referencing foreign key, and
// makes ids differ between environments.
//
// Application code refers to these via the constants in
// src/common/constants/lookups.ts, which are checked against the database at
// startup so the two cannot drift silently.
// ============================================

model Role {
  code        String  @id // USER | MODERATOR | ADMIN | SUPER_ADMIN
  name        String
  description String?

  users User[]

  @@map("roles")
}

/// The published rating scale. Absorbs the former `VerdictDefinition` model:
/// once ratings are rows, the rating IS its own definition.
/// Definition text is a public editorial commitment — the client's words.
model VeracityRating {
  code         String  @id // TRUE | MOSTLY_TRUE | ... | MISLEADING
  labelAr      String
  labelEn      String
  definitionAr String  @db.Text
  definitionEn String  @db.Text
  position     Int     @default(0)
  description  String?

  factChecks         FactCheck[]
  articleRevisions   ArticleRevision[]
  verdictChangesFrom VerdictChange[]   @relation("VerdictChangeFrom")
  verdictChangesTo   VerdictChange[]   @relation("VerdictChangeTo")

  @@map("veracity_ratings")
}

model SubmissionStatus {
  code        String  @id // PENDING | IN_REVIEW | VERIFIED | REJECTED | PUBLISHED
  name        String
  description String?

  submissions Submission[]

  @@map("submission_statuses")
}

model SubmissionType {
  code        String  @id // TEXT | IMAGE | VIDEO | AUDIO | LINK
  name        String
  description String?

  submissions Submission[]

  @@map("submission_types")
}

model ContentStatus {
  code        String  @id // DRAFT | UNDER_REVIEW | PUBLISHED | ARCHIVED | RETRACTED
  name        String
  description String?

  // Previously declared `submissions Submission[]`, which was wrong —
  // Submission is keyed by SubmissionStatus, not ContentStatus.
  factCheckArticles FactCheckArticle[]
  sessions          Session[]
  blogs             Blog[]
  research          Research[]

  @@map("content_statuses")
}

model Locale {
  code        String  @id // ISO 639-1: AR | EN
  name        String
  description String?

  claims            Claim[]
  factCheckArticles FactCheckArticle[]

  @@map("locales")
}

model EvidenceType {
  code        String  @id // PRIMARY_SOURCE | OFFICIAL_RECORD | ... | OTHER
  name        String
  description String?

  evidence Evidence[]

  @@map("evidence_types")
}

model RevisionTier {
  code        String  @id // SILENT | UPDATE | CORRECTION | VERDICT_CHANGE
  name        String
  description String?

  // Previously declared `submissions Submission[]`, which was wrong —
  // revision tiers belong to ArticleRevision.
  articleRevisions ArticleRevision[]

  @@map("revision_tiers")
}

model EventType {
  code        String  @id // WORKSHOP | WEBINAR | EXHIBITION | CONFERENCE | TRAINING
  name        String
  description String?

  events       Event[]
  hostRequests HostRequest[]

  @@map("event_types")
}

model EventStatus {
  code        String  @id // UPCOMING | ONGOING | COMPLETED | CANCELLED
  name        String
  description String?

  events Event[]

  @@map("event_statuses")
}

model NotificationType {
  code        String  @id // SUBMISSION_UPDATE | EVENT_REMINDER | ... | SYSTEM
  name        String
  description String?

  notifications Notification[]

  @@map("notification_types")
}

model ModerationAction {
  code        String  @id // APPROVE | REJECT | FLAG | ESCALATE
  name        String
  description String?

  // Previously had no back-relation at all.
  moderationLogs ModerationLog[]

  @@map("moderation_actions")
}
